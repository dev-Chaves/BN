                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": {\n    \"name\": \"BN Dev Company\",\n    \"cnpj\": \"10000000700120\"\n  },\n  \"manager\": {\n    \"name\": \"Manager Dev\",\n    \"cpf\": \"00000700177\",\n    \"email\": \"manager.dev@bn.local\",\n    \"password\": \"manager-pass-123\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/onboarding",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
