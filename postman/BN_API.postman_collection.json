              ]
            }
          },
          "response": []
        },
        {
          "name": "Auth - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Extrair token JWT do cookie e salvar na variável de ambiente",
                  "var setCookie = pm.response.headers.get('Set-Cookie');",
                  "if (setCookie) {",
                  "    var match = setCookie.value.match(/jwt=([^;]+)/);",
                  "    if (match && match[1]) {",
                  "        pm.environment.set('jwtToken', match[1]);",
                  "        console.log('JWT salvo com sucesso');",
                  "    }",
                  "}",
                  "",
                  "pm.test('Status code é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Resposta contém token', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager.dev@bn.local\",\n  \"password\": \"manager-pass-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
