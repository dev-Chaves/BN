# =============================================
# Application profile
# =============================================
QUARKUS_PROFILE=dev
QUARKUS_HTTP_HOST=0.0.0.0
QUARKUS_HTTP_PORT=9090

# =============================================
# Database (PostgreSQL)
# =============================================
QUARKUS_DATASOURCE_DB_KIND=postgresql
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=password

# JDBC (Flyway)
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/benefix

# Reactive (Hibernate Reactive)
QUARKUS_DATASOURCE_REACTIVE_URL=postgresql://localhost:5432/benefix

# Pool sizing
QUARKUS_DATASOURCE_REACTIVE_MAX_SIZE=5
QUARKUS_DATASOURCE_JDBC_MAX_SIZE=3

# =============================================
# Hibernate / ORM
# =============================================
QUARKUS_HIBERNATE_ORM_DATABASE_GENERATION=validate
QUARKUS_HIBERNATE_ORM_LOG_SQL=false

# =============================================
# Flyway
# =============================================
QUARKUS_FLYWAY_MIGRATE_AT_START=true

# =============================================
# JWT (mounted secret files in container)
# =============================================
MP_JWT_VERIFY_PUBLICKEY_LOCATION=publicKey.pem
MP_JWT_VERIFY_ISSUER=bn-api
SMALLRYE_JWT_SIGN_KEY_LOCATION=privateKey.pem

# =============================================
# Cookie
# =============================================
APP_COOKIE_SECURE=true

# =============================================
# Swagger/OpenAPI in production
# Keep enabled if you want docs available with Basic Auth.
# =============================================
QUARKUS_SWAGGER_UI_ALWAYS_INCLUDE=true
QUARKUS_SMALLRYE_OPENAPI_ENABLE=true
SWAGGER_BASIC_AUTH_USERNAME=admin
SWAGGER_BASIC_AUTH_PASSWORD=admin

AUTH_RATE_LIMIT_PERIOD_SECOND=1S
AUTH_RATE_LIMIT_USES_SECOND=30
AUTH_RATE_LIMIT_PERIOD_MINUTE=1M
AUTH_RATE_LIMIT_USES_MINUTE=100

ONBOARDING_RATE_LIMIT_PERIOD_SECOND=1S
ONBOARDING_RATE_LIMIT_USES_SECOND=20
ONBOARDING_RATE_LIMIT_PERIOD_MINUTE=1M
ONBOARDING_RATE_LIMIT_USES_MINUTE=50
