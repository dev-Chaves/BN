SPRING_PROFILES_ACTIVE=dev

# Banco PostgreSQL existente
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/benefix
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=3
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1

# JPA/Flyway
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_OPEN_IN_VIEW=false
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false

# JWT: arquivos provisionados externamente
JWT_PUBLIC_KEY_PATH=/opt/bn/secrets/publicKey.pem
JWT_PRIVATE_KEY_PATH=/opt/bn/secrets/privateKey.pem
APP_JWT_ISSUER=bn-api
APP_JWT_EXPIRATION=PT3H

# Cookie e aplicação
APP_COOKIE_SECURE=false
APP_PUBLIC_URL=http://localhost:3000
PORT=8080

# Swagger/OpenAPI (desabilitado por padrão; ative com SPRING_PROFILES_ACTIVE=docs)
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
SWAGGER_BASIC_AUTH_USERNAME=bnadmin
SWAGGER_BASIC_AUTH_PASSWORD=change-me

# Rate limit
AUTH_RATE_LIMIT_USES_SECOND=5
AUTH_RATE_LIMIT_USES_MINUTE=30
ONBOARDING_RATE_LIMIT_USES_SECOND=2
ONBOARDING_RATE_LIMIT_USES_MINUTE=10
REDEMPTION_RATE_LIMIT_USES_SECOND=10
REDEMPTION_RATE_LIMIT_USES_MINUTE=120
