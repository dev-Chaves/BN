# O binário nativo é compilado no runner do CI (.github/workflows/deploy.yaml)
# antes deste build. Este Dockerfile apenas empacota o binário pré-compilado —
# NÃO recompila o native image. Para build local (docker-compose), use o
# Dockerfile da raiz, que compila em multi-stage.
FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system spring \
    && useradd --system --gid spring spring
USER spring:spring
COPY target/ubm /app/ubm
EXPOSE 8080
ENTRYPOINT ["/app/ubm"]
